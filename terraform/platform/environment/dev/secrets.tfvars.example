# Copie este arquivo para "secrets.tfvars" (mesma pasta) e preencha com valores reais. "secrets.tfvars" está no .gitignore (environment/**/secrets.tfvars)
# — nunca commite o arquivo real, só este .example com placeholders.
#
#   cp environment/dev/secrets.tfvars.example environment/dev/secrets.tfvars
#
# Usado pelo Argo Workflow (argoworkflows-irsa.tf / argoworkflows-template.tf) para dar "git push" de volta no repositório depois do build (atualização
# de apps/springboot/values.yaml com a tag da imagem nova).

# Usuário GitHub dono do Personal Access Token abaixo.
github_username = "seu-usuario-github"

# Personal Access Token do GitHub, escopo "repo" (permite push). Gere em https://github.com/settings/tokens. Se vazar, revogue e gere um novo imediatamente.
github_token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
